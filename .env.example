# Example environment configuration (no secrets)
# Copy this file to .env and adjust values for your machine.

# ========================
# STEP5 — Tracking engines (simplified)
# ========================

# Supported values:
# - empty: default MediaPipe mode (CPU)
# - insightface: InsightFace (GPU-only)
STEP5_TRACKING_ENGINE=

# Global GPU toggle for STEP5
# NOTE: GPU mode is reserved for InsightFace only.
STEP5_ENABLE_GPU=0

# Engines allowed to use GPU (only 'insightface' is supported; 'all' is also accepted)
STEP5_GPU_ENGINES=insightface

# Auto-fallback to CPU if GPU is unavailable (VRAM / providers / etc.)
STEP5_GPU_FALLBACK_AUTO=1

# Max VRAM usage for STEP5 GPU worker (MB)
STEP5_GPU_MAX_VRAM_MB=2048

# Optional: Python interpreter for the InsightFace GPU environment (if separated)
STEP5_INSIGHTFACE_ENV_PYTHON=

# CPU tuning
TRACKING_CPU_WORKERS=15
TRACKING_DISABLE_GPU=0

# ========================
# STEP5 — Object detector fallback (EfficientDet)
# ========================

# Use object detection as fallback when face detection fails
STEP5_ENABLE_OBJECT_DETECTION=1

# Default model name in ObjectDetectorRegistry
STEP5_OBJECT_DETECTOR_MODEL=efficientdet_lite2

# Optional explicit path override
STEP5_OBJECT_DETECTOR_MODEL_PATH=

# ========================
# STEP4 — Audio Analysis (DeepInfra)
# ========================

# STEP4 method: pyannote, lemonfox, deepinfra
STEP4_METHOD=

# DeepInfra API Key (required for DeepInfra transcription)
DEEPINFRA_API_KEY=

# Base URL for DeepInfra API
DEEPINFRA_BASE_URL=https://api.deepinfra.com

# Transcriptions endpoint
DEEPINFRA_TRANSCRIPTIONS_ENDPOINT=/v1/openai/audio/transcriptions

# Full URL (optional, constructed from base + endpoint)
DEEPINFRA_TRANSCRIPTIONS_URL=

# Model to use
DEEPINFRA_MODEL=openai/whisper-large-v3

# Timeout in seconds
DEEPINFRA_TIMEOUT_SEC=300

# Max retries
DEEPINFRA_MAX_RETRIES=2

# Backoff between retries
DEEPINFRA_BACKOFF_SEC=1.5

# Default language (optional)
DEEPINFRA_DEFAULT_LANGUAGE=

# Default prompt (optional)
DEEPINFRA_DEFAULT_PROMPT=

# Response format: json, verbose_json, text, srt, vtt
DEEPINFRA_RESPONSE_FORMAT=verbose_json

# Timestamp granularities: segment, word (comma separated)
DEEPINFRA_TIMESTAMP_GRANULARITIES=segment

# Temperature (optional, for randomness)
DEEPINFRA_TEMPERATURE=

# Fallback to Pyannote if DeepInfra fails
STEP4_DEEPINFRA_FALLBACK_TO_PYANNOTE=1

# Speech gap fill seconds
DEEPINFRA_SPEECH_GAP_FILL_SEC=0.15

# Minimum speech on seconds
DEEPINFRA_SPEECH_MIN_ON_SEC=0.0
