# Example environment configuration (no secrets)
# Copy this file to .env and adjust values for your machine.

# ==============================================================================
# SCHÉMA DES VARIABLES D'ENVIRONNEMENT
# ==============================================================================
# Les variables `STEPn_*` suivent la numérotation actuelle du pipeline :
#   STEP1_*  -> étape 1 : extraction + normalisation vidéo
#   STEP2_*  -> étape 2 : analyse des transitions (scene detection)
#   STEP3_*  -> étape 3 : analyse audio & diarisation
#   STEP4_*  -> étape 4 : tracking visage / corps / objets
#   STEP5_*  -> étape 5 : réduction JSON & analytics
#   STEP6_*  -> étape 6 : pré-traitement After Effects (CEP / ExtendScript)
#   STEP7_*  -> étape 7 : finalisation
#   STEP8_*  -> étape 8 : Media Solution (EffectCraft)
#
# `ENV_STEP_SCHEMA=2` marque ce schéma. Un `.env` resté au schéma 1 est détecté
# au démarrage et doit être migré via :
#   python scripts/migrate_env_step_names.py
ENV_STEP_SCHEMA=2

# ==============================================================================
# 1. CONFIGURATION GÉNÉRALE FLASK & SÉCURITÉ
# ==============================================================================
# Mode debug (false en production)
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Emplacement racine des environnements virtuels
# Sert de base pour tous les environnements (env/, transnet_env/, audio_env/, etc.)
# Laisser vide pour utiliser le répertoire du projet par défaut.
VENV_BASE_DIR=

# Sécurité & Tokens internes (obligatoires en production)
INTERNAL_WORKER_COMMS_TOKEN=dev-internal-worker-token
FLASK_SECRET_KEY=dev-secret-key-change-in-production

# ==============================================================================
# 2. WEBHOOK & TÉLÉCHARGEMENTS AUTOMATIQUES (PROXY R2 / DROPBOX)
# ==============================================================================
# Configuration du webhook (source unique de données)
WEBHOOK_JSON_URL=https://webhook.kidpixel.fr/data/webhook_links.json
WEBHOOK_TIMEOUT=10
WEBHOOK_MONITOR_INTERVAL=15

# Téléchargements automatiques : les archives sont téléchargées dans LOCAL_DOWNLOADS_DIR
# via une URL r2_url (proxy Cloudflare) avec repli sur le lien Dropbox d'origine.
# Écriture en .part puis renommage atomique en .zip après validation d'intégrité.

# Taille des chunks d'écriture disque (octets)
DOWNLOAD_CHUNK_SIZE_BYTES=524288

# Connexion (s) et attente maximale entre deux chunks (s)
DOWNLOAD_CONNECT_TIMEOUT_S=15
DOWNLOAD_CHUNK_TIMEOUT_S=60

# Sonde HEAD initiale (s)
DOWNLOAD_PROBE_TIMEOUT_S=10

# Tentatives par URL (primaire puis repli) et backoff exponentiel (s)
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RETRY_BACKOFF_S=1.0

# Intervalle minimal entre deux mises à jour de progression (s)
DOWNLOAD_PROGRESS_MIN_INTERVAL_S=1.0

# Taille minimale acceptée pour une archive (octets) et validation intégrité ZIP
DOWNLOAD_MIN_ZIP_SIZE_BYTES=1000000
DOWNLOAD_VALIDATE_ZIP=true

# Plafond du cooldown exponentiel après échecs répétés d'une URL (s)
DOWNLOAD_COOLDOWN_MAX_S=3600

# ==============================================================================
# 3. MÉTRIQUES SYSTÈME & DÉVELOPPEMENT
# ==============================================================================
# Métriques échantillonnées en arrière-plan et servies depuis un cache (non-bloquant)
SYSTEM_SNAPSHOT_INTERVAL_S=2.0

# Seuil de journalisation WARNING pour une réponse API lente (ms)
SLOW_API_THRESHOLD_MS=1000

# Paramètres de test et de développement
DRY_RUN_DOWNLOADS=false
GROQ_API_KEY=

# ==============================================================================
# 4. ACCÉLÉRATEURS MATÉRIELS GLOBAUX (CORAL TPU & OPENCV 5.0)
# ==============================================================================
# Activer l'accélération matérielle Google Coral Edge TPU (/dev/apex_0) pour STEP 2, 3, 4
ENABLE_CORAL_TPU_ACCELERATION=true
STEP2_ENABLE_CORAL_TPU=true
STEP3_ENABLE_CORAL_TPU=true
STEP4_ENABLE_CORAL_TPU=true

# Moteur GPU Zero-Copy ONNX Runtime (IOBinding) pour STEP2 et expérimental OpenCV 5.0 DNN (graphe) pour STEP4
# Activer pour router l'exécution vers l'environnement dédié (transnet_cv5_env : > 260x temps réel / tracking_cv5_env)
USE_OPENCV5_STEP2=false
USE_OPENCV5_STEP4=false

# ==============================================================================
# 5. STEP1 — EXTRACTION, NORMALISATION VIDÉO & MÉDIAS PRÉSERVÉS
# ==============================================================================
# Normalisation vidéo obligatoire vers le contrat : MP4 / H.264 / yuv420p / 25 fps.
# Les étapes aval indexent leurs résultats par numéro de frame.
STEP1_NORMALIZE_VIDEOS=true
STEP1_FPS_TARGET=25
STEP1_USE_GPU=true
STEP1_QUALITY_CRF=28
STEP1_MAX_GPU_WORKERS=3

# Médias préservés (.mov portant une couche alpha ou listés ci-dessous)
# Un .mov préservé n'est ni normalisé ni analysé, et copié tel quel par STEP7 dans docs/.
SKIP_MOV_FILES=true
PRESERVED_MOV_NAMES=m6+.mov

# ==============================================================================
# 6. STEP2 — ANALYSE DES TRANSITIONS (SCENE DETECTION)
# ==============================================================================
# Forcer le mode CPU pour le moteur OpenCV 5.0 / ONNX Runtime dans STEP2 (défaut: false)
STEP2_CV5_FORCE_CPU=false

# Stratégie de recherche d'algorithme de convolution cuDNN pour TransNetV2 GPU :
# - EXHAUSTIVE (défaut) : benchmarcke tous les algorithmes cuDNN au warm-up pour débit maximal (> 260x temps réel)
# - HEURISTIC : repli immédiat sans benchmarking si instabilité cuDNN au warm-up
# - DEFAULT : algorithme par défaut cuDNN
STEP2_CUDNN_ALGO_SEARCH=EXHAUSTIVE

# ==============================================================================
# 7. STEP3 — ANALYSE AUDIO & DIARISATION
# ==============================================================================
# Méthode audio : pyannote, lemonfox, deepinfra
STEP3_METHOD=

# --- Service Lemonfox (transcription audio cloud) ---
AUDIO_PROFILE=gpu_fp32
AUDIO_GPU_ISOLATION=1
LEMONFOX_API_KEY=
LEMONFOX_EU_DEFAULT=0
LEMONFOX_TIMESTAMP_GRANULARITIES=word
LEMONFOX_SPEECH_MIN_ON_SEC=0.0
LEMONFOX_DEFAULT_MIN_SPEAKERS=1
LEMONFOX_MAX_UPLOAD_MB=100
LEMONFOX_ENABLE_TRANSCODE=1
LEMONFOX_TRANSCODE_AUDIO_CODEC=aac
LEMONFOX_TRANSCODE_BITRATE_KBPS=96

# --- Service Pyannote / Hugging Face (diarisation locale) ---
HF_AUTH_TOKEN=
HUGGINGFACE_HUB_TOKEN=

# --- Service DeepInfra (transcription audio alternative) ---
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com
DEEPINFRA_TRANSCRIPTIONS_ENDPOINT=/v1/openai/audio/transcriptions
DEEPINFRA_TRANSCRIPTIONS_URL=
DEEPINFRA_MODEL=openai/whisper-large-v3
DEEPINFRA_TIMEOUT_SEC=300
DEEPINFRA_CONNECT_TIMEOUT_SEC=10
DEEPINFRA_MAX_RETRIES=2
DEEPINFRA_BACKOFF_SEC=1.5
DEEPINFRA_DEFAULT_LANGUAGE=
DEEPINFRA_DEFAULT_PROMPT=
DEEPINFRA_RESPONSE_FORMAT=verbose_json
DEEPINFRA_TIMESTAMP_GRANULARITIES=segment
DEEPINFRA_TEMPERATURE=
STEP3_DEEPINFRA_FALLBACK_TO_PYANNOTE=1
DEEPINFRA_SPEECH_GAP_FILL_SEC=0.15
DEEPINFRA_SPEECH_MIN_ON_SEC=0.0

# --- Optimisations du pipeline audio Coral TPU (run_audio_diarization_tpu.py) ---
# Nombre de vidéos analysées en parallèle par ThreadPoolExecutor (défaut: CPU // 2)
STEP3_MAX_WORKERS=4

# Architecture YAMNet Split (Frontend CPU Log-Mel + CNN MobileNetV1 compilé 100% Edge TPU) :
#   0 = modèle legacy monolithique (non compilable sur TPU, repli CPU/XNNPACK)
#   1 = modèle split compilé (recommandé : 100% ASIC TPU sur /dev/apex_0, latence ~1.1 ms)
STEP3_YAMNET_SPLIT=1

# Mode strict Edge TPU :
#   0 = journalise l'absence du délégué edgetpu-custom-op mais tolère le repli CPU
#   1 = mode strict, stoppe immédiatement en erreur critique si le TPU n'est pas alloué
STEP3_REQUIRE_EDGETPU=0

# Pas d'échantillonnage temporel des d-vectors ECAPA-TDNN :
#   1 = exhaustif (défaut de production, zéro régression acoustique locale)
#   2 = sous-échantillonnage 1/2 (+43.5% plus rapide, réservé aux dialogues longs)
#   auto / adaptive = bascule automatique à 2 si parole >= STEP3_ADAPTIVE_THRESHOLD
STEP3_EMBEDDING_STRIDE=1
STEP3_ADAPTIVE_STRIDE=0
STEP3_ADAPTIVE_THRESHOLD=500

# Moteur d'inférence ECAPA ONNX Runtime :
#   0 = accélération OpenVINO CPU FP32 automatique (gain 1.5-1.7x sur CPU Intel)
#   1 = force l'Execution Provider CPU standard (diagnostic / compatibilité)
STEP3_DISABLE_OPENVINO=0

# ==============================================================================
# 8. STEP4 — TRACKING VISAGE, CORPS & OBJETS
# ==============================================================================
# Moteur de tracking principal :
# - vide : mode par défaut MediaPipe (CPU)
# - insightface : InsightFace (GPU uniquement)
STEP4_TRACKING_ENGINE=

# --- Support GPU & InsightFace (réservé exclusivement à InsightFace) ---
STEP4_ENABLE_GPU=0
STEP4_GPU_ENGINES=insightface
STEP4_GPU_FALLBACK_AUTO=1
STEP4_GPU_MAX_VRAM_MB=2048
STEP4_INSIGHTFACE_MODEL_NAME=antelopev2
STEP4_INSIGHTFACE_DET_SIZE=480
STEP4_INSIGHTFACE_MAX_FACES=4
STEP4_INSIGHTFACE_JAWOPEN_SCALE=1.0
STEP4_INSIGHTFACE_ALLOWED_MODULES=detection,landmark_3d_68
STEP4_INSIGHTFACE_MAX_WIDTH=1280
STEP4_INSIGHTFACE_ENV_PYTHON=
INSIGHTFACE_HOME=

# --- Workers CPU & MediaPipe Tasks (mode CPU par défaut) ---
TRACKING_CPU_WORKERS=15
TRACKING_DISABLE_GPU=0
STEP4_MEDIAPIPE_JAWOPEN_SCALE=1.0

# --- Détecteur d'objets (fallback quand aucun visage n'est détecté) ---
STEP4_ENABLE_OBJECT_DETECTION=1
STEP4_OBJECT_DETECTOR_MODEL=efficientdet_lite2
STEP4_OBJECT_DETECTOR_MODEL_PATH=

# --- Optimisations Coral TPU Tracking (run_tracking_tpu.py) ---
# Nombre de frames consécutives sans visage avant d'invoquer le détecteur d'objets TPU.
# 1 = comportement historique ; 25 = amortit et évite d'évincer la SRAM.
STEP4_TPU_OBJECT_DETECTION_MIN_MISSING=25

# Nombre de frames consécutives AVEC visage nécessaires pour réarmer le compteur.
STEP4_TPU_OBJECT_DETECTION_FACE_RESET_FRAMES=1

# Niveau d'optimisation du pipeline TPU :
#   0 = comportement historique (référence A/B)
#   1 = gains sûrs validés par benchmark (défaut) : hystérésis, caches ancres/interpréteur, flush JSON groupé
#   2 = réservé (optimisations structurelles)
STEP4_TPU_FAST=1

# Threads TFLite des modèles CPU (Blendshapes)
STEP4_TPU_CPU_THREADS=1

# Dossier des rapports de profilage par étage (vide = désactivé)
STEP4_TPU_PROFILING_DIR=

# --- Pipeline Expérimental OpenCV 5.0 (run_tracking_cv5.py) ---
STEP4_CV5_NUM_WORKERS=4
STEP4_CV5_WORKER_MODE=auto
STEP4_CV5_INFERENCE_DEVICE=cpu
STEP4_CV5_CPU_BUDGET=15
STEP4_CV5_MAX_ACTIVE_VIDEOS=4
STEP4_CV5_MIN_FRAMES_PER_WORKER=80
STEP4_CV5_CHUNK_FRAMES=32
STEP4_CV5_MAX_WORKERS_BY_MEMORY=15

# --- Blendshapes, Throttling & Exports ---
STEP4_BLENDSHAPES_PROFILE=full
STEP4_BLENDSHAPES_EXPORT_KEYS=jawOpen
STEP4_BLENDSHAPES_THROTTLE_N=1
STEP4_ENABLE_VOLUMINOUS_EXPORTS=false

# ==============================================================================
# 9. STEP5 — RÉDUCTION JSON & ANALYTICS
# ==============================================================================
STEP5_INCLUDE_TRACKING_ANALYTICS=1
STEP5_EXPRESSION_KEYS=jawOpen

# ==============================================================================
# 10. STEP8 — MEDIA SOLUTION (EFFECTCRAFT)
# ==============================================================================
# Génération headless des projets EffectCraft <video>_9x16.ecproj via le panel MediaSolution.jsx
STEP8_TIMEOUT=14400
STEP8_EFFECTCRAFT_CLI=effectcraft-cli
STEP8_PANEL_JSX=
STEP8_PANEL_CONFIG=

# Mode d'exécution de l'étape 8 : auto (défaut), headless (<= 0.7) ou bridge (0.8+)
STEP8_MODE=auto
STEP8_BRIDGE_PORT=9877
STEP8_AUTO_LAUNCH_APP=true
STEP8_EFFECTCRAFT_APP=effectcraft
STEP8_APP_LAUNCH_TIMEOUT=60
