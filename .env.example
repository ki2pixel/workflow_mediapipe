# Example environment configuration (no secrets)
# Copy this file to .env and adjust values for your machine.

# ========================
# STEP5 — Tracking engines (simplified)
# ========================

# Supported values:
# - empty: default MediaPipe mode (CPU)
# - insightface: InsightFace (GPU-only)
STEP5_TRACKING_ENGINE=

# Global GPU toggle for STEP5
# NOTE: GPU mode is reserved for InsightFace only.
STEP5_ENABLE_GPU=0

# Engines allowed to use GPU (only 'insightface' is supported; 'all' is also accepted)
STEP5_GPU_ENGINES=insightface

# Auto-fallback to CPU if GPU is unavailable (VRAM / providers / etc.)
STEP5_GPU_FALLBACK_AUTO=1

# Max VRAM usage for STEP5 GPU worker (MB)
STEP5_GPU_MAX_VRAM_MB=2048

# Optional: Python interpreter for the InsightFace GPU environment (if separated)
STEP5_INSIGHTFACE_ENV_PYTHON=

# CPU tuning
TRACKING_CPU_WORKERS=15
TRACKING_DISABLE_GPU=0

# ========================
# STEP5 — Object detector fallback (EfficientDet)
# ========================

# Use object detection as fallback when face detection fails
STEP5_ENABLE_OBJECT_DETECTION=1

# Default model name in ObjectDetectorRegistry
STEP5_OBJECT_DETECTOR_MODEL=efficientdet_lite2

# Optional explicit path override
STEP5_OBJECT_DETECTOR_MODEL_PATH=

# ========================
# STEP5 — Debug / output
# ========================

STEP5_ENABLE_PROFILING=0
STEP5_BLENDSHAPES_THROTTLE_N=1
STEP5_EXPORT_VERBOSE_FIELDS=false
